# =================================================================
# CodeAlpha Full-Stack Monorepo — Environment Variables Template
# =================================================================

# -----------------------------------------------------------------
# Task 1: ShopSphere (E-Commerce Platform)
# -----------------------------------------------------------------
# Backend: task-1-ecommerce/backend/.env
TASK1_PORT=5000
TASK1_NODE_ENV=development
TASK1_MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere
TASK1_JWT_SECRET=shopsphere_super_secret_jwt_key_2025_codealpha_fullstack
TASK1_CLIENT_URL=http://localhost:5173

# Frontend: task-1-ecommerce/frontend/.env
VITE_TASK1_API_URL=/api

# -----------------------------------------------------------------
# Task 2: Pulse (Social Media Platform)
# -----------------------------------------------------------------
# Backend: task-2-social-media/backend/.env
TASK2_PORT=5001
TASK2_NODE_ENV=development
TASK2_MONGODB_URI=mongodb://127.0.0.1:27017/pulse_social
TASK2_JWT_SECRET=pulse_super_secret_jwt_key_2025_codealpha_fullstack
TASK2_CLIENT_URL=http://localhost:5174

# Frontend: task-2-social-media/frontend/.env
VITE_TASK2_API_URL=/api
VITE_TASK2_SOCKET_URL=http://localhost:5001

# -----------------------------------------------------------------
